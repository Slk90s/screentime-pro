# Dependencies
node_modules/

# Frontend build output
dist/

# Rust / Tauri build artifacts
src-tauri/target/
src-tauri/gen/

# Tauri generated (schemas, etc.)
src-tauri/Cargo.lock
# NOTE: 若希望锁定依赖可取消上面一行并改为提交 Cargo.lock

# Release binaries (发布安装包通过 GitHub Releases 分发，不入库)
release/

# 本地发布下载暂存（从 GitHub Releases 拉安装包核对 / 转传 Gitee 时用，勿入库）
# - 2026-09-10 @v0.7.7: 新增。一次 Gitee 发版在此目录留下 6 个安装包 + 8 个 AppImage 分片
#   共 245MB 且此前未被忽略——`git add -A` 会把整包提交进仓库（GitHub 单文件 100MB 上限
#   会直接拒绝推送）。新增同类临时目录时务必同步补规则。
.tmp-release/

# 本地构建产物 / AI 生图临时目录（不入库，CI 重新产出）
output/
generated-images/

# 本地专用脚本（仅本地，不入库）
scripts/

# 本地 AI 生图原始稿 / 未引用素材（不入库，仅本地参考）
src/pet/skins/spiderman/assets/Cute_chibi_style_superhero_*.png
src/pet/skins/spiderman/assets/spiderman-single.png

# 本地生成 / 开发脚本（不入库）
gen_pet_frames.py
gen_spiderman_frames.py
sandbox-vite-tauri-workaround.zip

# 文档备份（§8：覆盖/追加不明时先备份落此目录，临时安全网，不入库）
bak/

# 文档 markdown：仅 README + docs/ARCHITECTURE.md + docs/RELEASE.md 传 GitHub；其余 .md（AGENTS/CONVENTIONS + docs 计划/约束/审计等）留本地
# - 2026-09-04 @v0.7.5: 修复 - 追加 !docs/RELEASE.md 例外。此前 docs/ 下除 ARCHITECTURE 外
#   全部被忽略，导致 README 与 ARCHITECTURE 引用的 docs/RELEASE.md 从未真正入库（死链）。
#   新增 docs/ 下需公开的文档时，必须在此显式加白名单，否则写了也会被 git 静默忽略。
docs/*.md
docs/**/*.md
!docs/ARCHITECTURE.md
!docs/RELEASE.md

# 根目录 AI 协作规范（约束类）仅本地，不传 GitHub
# - 2026-09-04 @v0.7.5: 修复 - 追加 CONVENTIONS-*.md。项目专属约束
#   （CONVENTIONS-screentime-pro.md）同属约束类，应与 CONVENTIONS.md 一致不入库；
#   不加这条会因文件名不匹配 CONVENTIONS.md 而被意外提交。
AGENTS.md
CONVENTIONS.md
CONVENTIONS-*.md
CHANGELOG.md

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local env
.env
.env.local

# WorkBuddy / agent 记忆（不随仓库开源）
.workbuddy/
